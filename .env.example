# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# Local example. For Supabase use the *Session pooler* connection string
# (Project → Connect → Session pooler) and set DATABASE_SSL=true.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tapaccess
DATABASE_SSL=false
DATABASE_LOGGING=false

# ─── Auth ───────────────────────────────────────────────────────────────────
# At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=12h
COOKIE_NAME=tapaccess_session
# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ─── Web / CORS ─────────────────────────────────────────────────────────────
# Public URL of the Next.js frontend. Requests from any other origin are rejected.
FRONTEND_URL=http://localhost:3001
# Extra comma-separated origins (e.g. Vercel preview URLs).
# CORS_ORIGINS=https://tapaccess-git-main-you.vercel.app
# Reverse proxies in front of the API (Render = 1).
TRUST_PROXY=1
# Shared secret sent by the Next.js server when it fetches public profiles so
# that all server-side renders are not rate-limited as one IP. Must match
# INTERNAL_API_KEY in the frontend. Leave unset to disable the bypass.
# INTERNAL_API_KEY=

# ─── Analytics ──────────────────────────────────────────────────────────────
# Salt for the anonymous daily visitor hash. Falls back to JWT_SECRET.
# ANALYTICS_SALT=

# ─── Image storage ──────────────────────────────────────────────────────────
# local    → files written to UPLOAD_DIR and served at /uploads (dev only;
#            Render's disk is wiped on every deploy)
# supabase → Supabase Storage (create a *public* bucket named SUPABASE_BUCKET)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
LOCAL_UPLOAD_BASE_URL=/uploads
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=tapaccess-media
MAX_UPLOAD_MB=8

# ─── Initial admin (read only by `npm run admin:create`) ────────────────────
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Super Admin
# ADMIN_PASSWORD=

# ─── Privacy ────────────────────────────────────────────────────────────────
# Raw visit/click rows older than this many days are deleted daily.
ANALYTICS_RETENTION_DAYS=400
